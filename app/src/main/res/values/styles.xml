<resources>
    <style name="KeyBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="KeyBtn" parent="KeyBase">
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="FuncKeyBtn" parent="KeyBase">
        <item name="android:background">@drawable/key_func_bg</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="EnterKeyBtn" parent="KeyBase">
        <item name="android:background">@drawable/key_enter_bg</item>
        <item name="android:textColor">@color/enter_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SpaceKeyBtn" parent="KeyBtn">
        <item name="android:textSize">14sp</item>
    </style>
</resources>
