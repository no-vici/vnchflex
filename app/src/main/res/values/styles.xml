<resources>
    <style name="KeyBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2.5dp</item>
        <item name="android:layout_marginEnd">2.5dp</item>
        <item name="android:layout_marginTop">3.5dp</item>
        <item name="android:layout_marginBottom">3.5dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="KeyBtn" parent="KeyBase">
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textSize">21sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Gboard Number Row: Pure number keys only, no secondary symbol -->
    <style name="NumberKeyBtn" parent="KeyBase">
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">2.5dp</item>
        <item name="android:layout_marginBottom">2.5dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="FuncKeyBtn" parent="KeyBase">
        <item name="android:background">@drawable/key_func_bg</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="OvalFuncKeyBtn" parent="FuncKeyBtn">
        <item name="android:background">@drawable/key_oval_func_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">4dp</item>
    </style>

    <style name="OvalImageKeyBtn" parent="FuncKeyBtn">
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="LogoSwitchKeyBtn" parent="FuncKeyBtn">
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="EnterKeyBtn" parent="KeyBase">
        <item name="android:background">@drawable/key_enter_bg</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="SpaceKeyBtn" parent="KeyBtn">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/key_text</item>
    </style>

    <style name="ToolbarChipBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:background">@drawable/key_func_bg</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">11.5sp</item>
    </style>
</resources>
